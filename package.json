{
  "name": "princetonlive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:seo": "node scripts/build-seo-pages.mjs",
    "refresh:data": "node scripts/fetch-live-data.mjs",
    "refresh:civic": "node scripts/fetch-civic-map.mjs",
    "refresh:waste": "node scripts/fetch-waste-data.mjs",
    "refresh:public": "npm run refresh:data && npm run refresh:civic && npm run refresh:waste",
    "build:hero": "node scripts/build-hero-image.mjs",
    "build": "npm run refresh:public && npm run build:seo && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "fast-xml-parser": "^4.5.7",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
